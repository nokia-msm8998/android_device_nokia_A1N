        vendor: true,
}

prebuilt_etc {
        name: "init.fih.poweroff_charging.rc",
        src: "init.fih.poweroff_charging.rc",
        sub_dir: "init/hw",
        vendor: true,
}

prebuilt_etc {
        name: "init.fih.modemconfig.rc",
        src: "init.fih.modemconfig.rc",
        sub_dir: "init/hw",
        vendor: true,
}
